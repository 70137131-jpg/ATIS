# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environments
venv/
.venv/
env/
ENV/
virtualenv/

# Python cache and test cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Flask local runtime files
instance/
*.db
*.sqlite
*.sqlite3

# Uploads and generated exports
uploads/
app/static/uploads/original/*
app/static/uploads/processed/*
!app/static/uploads/original/.gitkeep
!app/static/uploads/processed/.gitkeep
exports/
app/static/exports/

# AI model artifacts
ai_model/*.h5
ai_model/*.keras
ai_model/*.pt
ai_model/*.pth
ai_model/*.onnx
ai_model/models/*.h5
ai_model/models/*.keras
ai_model/models/*.pt
ai_model/models/*.pth
ai_model/models/*.onnx

# Logs
logs/
*.log

# Operating system files
.DS_Store
Thumbs.db

# IDE/editor files
.idea/
.vscode/
*.code-workspace

# Node/frontend tooling, if ever generated by tools
node_modules/
dist/
build/
