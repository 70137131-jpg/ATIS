# Copy this file to .env and update values for your local setup.
#
# Environment: "development" (default) or "production". In production the app
# REFUSES to start unless SECRET_KEY is set to a strong, unique value, and demo
# users / login aliases are disabled by default.
# ATIS_ENV=development

# Session secret. Generate a strong one for production with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# The placeholder below is fine for local dev but is REJECTED in production.
SECRET_KEY=atis-secret-key-change-in-production

# Enable the Flask debug server (local only — never in production). Default off.
# FLASK_DEBUG=0

# Leave DATABASE_URL unset to use the included local SQLite database:
#   instance/atis.db
#
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/atis_db

# Max upload size in MB (oversized uploads are rejected with HTTP 413). Default 10.
# ATIS_MAX_UPLOAD_MB=10
# Max decoded image pixels for uploads. Default 12000000.
# ATIS_MAX_IMAGE_PIXELS=12000000

# Automatic number plate recognition. Uses the optional pytesseract Python
# package plus the system tesseract binary. If OCR tooling is unavailable, plate
# reading is skipped and inspections still complete normally.
# ATIS_ANPR_ENABLED=1
# ATIS_ANPR_MIN_CONFIDENCE=55

# Inspection image persistence. Default "db" stores bytes in Postgres/SQLite for
# demos. Use "s3" for S3-compatible object storage in production.
# ATIS_IMAGE_STORAGE=db
# ATIS_IMAGE_STORAGE=s3
# ATIS_S3_BUCKET=atis-inspection-images
# ATIS_S3_REGION=us-east-1
# ATIS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
# ATIS_IMAGE_PREFIX=inspection-images
# Redirect /media/inspection/<id> to short-lived S3 URLs instead of proxying bytes.
# ATIS_S3_SIGNED_URLS=0
# ATIS_S3_SIGNED_URL_EXPIRES=900
# S3 client resilience knobs.
# ATIS_S3_CONNECT_TIMEOUT=3
# ATIS_S3_READ_TIMEOUT=10
# ATIS_S3_MAX_ATTEMPTS=3
# ATIS_S3_RETRY_MODE=standard

# Session lifetime in hours. Default 8.
# ATIS_SESSION_HOURS=8

# Max date range for report APIs/exports. Default 366 days.
# ATIS_REPORT_MAX_DAYS=366
# Max rows included in a PDF report export. Default 1000.
# ATIS_REPORT_EXPORT_MAX_ROWS=1000

# Rate-limit storage. In-memory by default; use Redis for multi-worker prod, e.g.
#   RATELIMIT_STORAGE_URI=redis://localhost:6379

# Data retention (PII governance). Inspections store plates + images and audit
# events store IP addresses — all personal data. 0 (default) means "keep
# forever"; set a window (in days) and schedule `flask atis-purge-expired
# --apply` from cron. Audit logs often outlive inspections for forensics.
# See docs/data_governance.md.
# ATIS_RETENTION_DAYS=0
# ATIS_AUDIT_RETENTION_DAYS=0

# --- Login security ---------------------------------------------------------
# Per-account lockout (independent of the per-IP login rate limit). After this
# many consecutive failures the account is locked for the window below.
# ATIS_MAX_LOGIN_ATTEMPTS=5
# ATIS_LOCKOUT_MINUTES=15
# Minimum password length enforced on create/reset/change (min 8).
# ATIS_MIN_PASSWORD_LENGTH=12

# --- Security headers -------------------------------------------------------
# Who may frame the app (CSP frame-ancestors + X-Frame-Options). Default 'self'.
# When embedding in a cross-site iframe (e.g. Hugging Face Spaces), list the
# parent, e.g.:  ATIS_FRAME_ANCESTORS="'self' https://*.hf.space https://huggingface.co"
# ATIS_FRAME_ANCESTORS='self'
# Override the whole Content-Security-Policy string if you need something custom.
# ATIS_CSP=

# --- Logging ----------------------------------------------------------------
# Emit structured JSON logs with a per-request correlation id (recommended in
# production so a log aggregator can parse/correlate). Default off (human logs).
# ATIS_LOG_JSON=1

# --- Caching ----------------------------------------------------------------
# Short-TTL in-process cache (seconds) for dashboard/report aggregations. 0
# (default) keeps results live; a small value (e.g. 30) bounds staleness while
# cutting repeated aggregate recomputation. Per-process; not read-your-writes.
# ATIS_STATS_CACHE_SECONDS=0

# --- Metrics ----------------------------------------------------------------
# /metrics exposes Prometheus gauges from the database. Leave the token unset to
# serve it openly (put it behind network policy), or set a token to require
# `Authorization: Bearer <token>` on the endpoint.
# ATIS_METRICS_TOKEN=change-me

# --- Async inference --------------------------------------------------------
# Run the slow model call in a background worker instead of blocking the request.
# When on, POST /predict returns a job id (202 for XHR, a polling page for form
# posts) and the UI polls /jobs/<id> for the result. No broker/worker process —
# a bounded in-process thread pool. See docs/security_and_operations.md.
# ATIS_ASYNC_INFERENCE=0
# Worker threads for background inference. Keep at 1 unless you have validated
# concurrent model calls and have RAM headroom (each in-flight job holds image +
# model working memory).
# ATIS_INFERENCE_WORKERS=1
# Run jobs inline instead of on the pool (debugging / deterministic tests).
# ATIS_INFERENCE_SYNC_JOBS=0

# Demo conveniences (auto-default to ON in development, OFF in production):
#   ATIS_SEED_DEMO=1     seed demo accounts, including operator@nha.gov.pk
#   ATIS_DEMO_ALIASES=1  accept *@nha.gov.pk logins mapped to the demo accounts
# In production, seeding demo users additionally REQUIRES ATIS_DEMO_PASSWORD:
# every demo account is created with that password instead of the well-known
# README ones (which would otherwise be a documented backdoor on a public host).
#   ATIS_DEMO_PASSWORD=change-me-strong
# Show the demo credentials box on the login page. Defaults to ON in
# development and OFF in production (the printed README password is wrong on a
# production host anyway, since demo accounts there use ATIS_DEMO_PASSWORD).
#   ATIS_SHOW_DEMO_CREDENTIALS=0

# Optional override. By default the app uses:
# runs/classify/ATIS_Project/tyre_safety_model/weights/best.pt
# ATIS_MODEL_PATH=/absolute/path/to/best.pt

# Optional training override, for example: 0, cpu, mps
# YOLO_DEVICE=0

# Confidence threshold (fraction 0-1) below which a 'normal' tire is flagged
# for manual review (treated as unsafe) instead of passed as safe. A 'cracked'
# prediction is always unsafe regardless of confidence. Default 0.60
# (retrained model: tuned for cracked recall >= 0.95 — see model_card.json).
# ATIS_CONF_THRESHOLD=0.60

# Reject obvious non-tyre frames before allowing a "normal/safe" result.
# Uses quick blank-frame checks plus the bundled COCO detector (yolo26n.pt).
# ATIS_TYRE_GATE=1
# ATIS_OBJECT_CONF_THRESHOLD=0.35

# Flat-frame gate tuning. A frame is rejected as "not a tyre" when its grayscale
# std-dev (contrast) or Canny edge-pixel fraction falls below these. Lower them
# for dark/hazy camera sites that falsely reject genuine tyre frames.
# ATIS_FLAT_CONTRAST_MIN=10
# ATIS_FLAT_EDGE_DENSITY_MIN=0.003

# Warm up the classifier at boot (load weights + one dummy inference) so the first
# real request isn't slow and a missing/corrupt model is caught at startup. The
# dev server (python3 app.py) warms up automatically; set this when serving under
# gunicorn. Fails hard in production so a broken model never serves traffic.
# ATIS_WARMUP=1

# Live dashboard/OpenCV stream settings. Camera can be an index, video file, or
# stream URL supported by OpenCV VideoCapture.
# ATIS_LIVE_CAMERA=0
# ATIS_LIVE_ZONES=config/live_zones.json
# ATIS_LIVE_WIDTH=1280
# ATIS_LIVE_HEIGHT=720
# ATIS_LIVE_DB_LOG=1
# ATIS_LIVE_ANALYZE_INTERVAL=0.5
# ATIS_LIVE_MOTION_THRESHOLD=8.0
# ATIS_LIVE_UNSAFE_STREAK=3
# ATIS_LIVE_COOLDOWN=20
# ATIS_LIVE_LOCATION=Dashboard Live Feed
# ATIS_LIVE_CAMERA_LABEL=DASHBOARD-LIVE
