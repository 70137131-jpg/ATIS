name: atis
region: nyc

services:
  - name: web
    github:
      repo: 70137131-jpg/ATIS
      branch: main
      deploy_on_push: true
    source_dir: /
    dockerfile_path: Dockerfile
    http_port: 8080
    instance_count: 1
    instance_size_slug: apps-s-1vcpu-2gb
    # Readiness gate: the platform only routes to an instance once its DB (and
    # model, under warmup) are actually ready — not merely once the process is up.
    health_check:
      http_path: /readyz
      initial_delay_seconds: 120
      period_seconds: 15
      failure_threshold: 3
    envs:
      # NOTE: values marked `type: SECRET` are encrypted at rest by the platform.
      # Prefer binding them from a secrets manager / the App Platform secret store
      # rather than committing real values into any tracked copy of this spec.
      - key: ATIS_ENV
        value: production
        scope: RUN_TIME
      - key: ATIS_LOG_JSON
        value: "1"
        scope: RUN_TIME
        type: GENERAL
        type: GENERAL
      - key: SECRET_KEY
        value: replace-with-a-generated-secret
        scope: RUN_TIME
        type: SECRET
      - key: ATIS_SEED_DEMO
        value: "1"
        scope: RUN_TIME
        type: GENERAL
      - key: DATABASE_URL
        value: ${postgres-db.DATABASE_URL}
        scope: RUN_TIME
        type: GENERAL
      - key: WEB_CONCURRENCY
        value: "1"
        scope: RUN_TIME
        type: GENERAL
      - key: GUNICORN_THREADS
        value: "4"
        scope: RUN_TIME
        type: GENERAL
      - key: ATIS_ADMIN_EMAIL
        value: admin@atis.com
        scope: RUN_TIME
        type: GENERAL
      - key: ATIS_ADMIN_PASSWORD
        value: replace-with-a-strong-admin-password
        scope: RUN_TIME
        type: SECRET
    alerts:
      - rule: MEM_UTILIZATION
        operator: GREATER_THAN
        value: 85
        window: FIVE_MINUTES

databases:
  - name: postgres-db
    engine: PG
    version: "18"
    production: false

ingress:
  rules:
    - match:
        path:
          prefix: /
      component:
        name: web

alerts:
  - rule: DEPLOYMENT_FAILED
  - rule: DOMAIN_FAILED
